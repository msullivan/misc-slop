#!/usr/bin/env python3
import sys

theirs = []
round_no = 0

while True:
    if round_no < 2:
        move = "C"
    elif round_no == 2:
        # A single early probe distinguishes unconditional cooperators from
        # players who answer defection with defection.
        move = "D"
    elif len(theirs) >= 2 and theirs[-1] == "D" and theirs[-2] == "D":
        # Do not donate points indefinitely to a persistent defector.
        move = "D"
    elif theirs and theirs[-1] == "D":
        # A single D is treated as a response to our probe; offer a repair.
        move = "C"
    else:
        # If they keep cooperating, keep testing/exploiting; if they retaliate,
        # the branch above switches back to cooperation.
        move = "D"

    print(move, flush=True)
    line = sys.stdin.readline()
    if not line:
        break
    response = line.strip()
    theirs.append(response if response in ("C", "D") else "D")
    round_no += 1
