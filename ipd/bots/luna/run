#!/usr/bin/env python3
import sys
from collections import deque

recent_defections = deque(maxlen=8)
defense_left = 0
repair_left = 0
defense_length = 2

while True:
    move = "D" if defense_left else "C"
    print(move, flush=True)
    response = sys.stdin.readline()
    if not response:
        break
    cooperated = response.strip() == "C"

    if defense_left:
        defense_left -= 1
        if not defense_left:
            # Give delayed reciprocators two chances to see cooperation.
            repair_left = 2
        continue

    if repair_left:
        if cooperated:
            defense_length = 2
            repair_left = 0
            recent_defections.clear()
        else:
            repair_left -= 1
            if not repair_left:
                defense_length = min(64, 2 * defense_length)
                defense_left = defense_length
        continue

    recent_defections.append(not cooperated)
    if sum(recent_defections) >= 2:
        defense_left = defense_length
