#!/usr/bin/env python3
import sys


def main():
    last_move = last_reply = 'C'
    cooperation = mutual_defection = alternating = 0
    repair_delay = 5
    forgive = False

    while True:
        repair = mutual_defection >= repair_delay or alternating >= 4
        move = 'C' if last_reply == 'C' or forgive or repair else 'D'
        print(move, flush=True)
        reply = sys.stdin.readline().strip()
        if reply not in ('C', 'D'):
            return

        # Give an established cooperator one round to withdraw a defection.
        forgive = move == 'C' and reply == 'D' and cooperation >= 8
        if move == reply == 'C':
            cooperation += 1
            if cooperation >= 4:
                repair_delay = 5
        else:
            cooperation = 0

        if repair and last_reply == 'D':
            repair_delay = min(80, repair_delay * 3)
        mutual_defection = mutual_defection + 1 if move == reply == 'D' else 0

        # A pair of reciprocators can get stuck swapping C/D and D/C.
        if move != reply and (move, reply) == (last_reply, last_move):
            alternating += 1
        else:
            alternating = int(move != reply)
        last_move, last_reply = move, reply


if __name__ == '__main__':
    main()
