#!/usr/bin/env python3
"""fable-1: tit-for-tat core with echo forgiveness and peace offers; against
opponents that do not reciprocate cooperation it switches to a learned
two-round-history model of the opponent and plays the best reply to it.
See NOTES.md."""
import sys

PAY = {('C', 'C'): 3, ('C', 'D'): 0, ('D', 'C'): 5, ('D', 'D'): 1}
PRIOR_C = 0.1      # assumed P(opponent C) in a never-seen situation
GAMMA = 0.95


class Bot:
    def __init__(self):
        self.my = []
        self.op = []
        # decayed stats: opponent cooperation after my C (p) / after my D (q)
        self.pn, self.pc = 1.0, 1.0
        self.qn, self.qc = 0.0, 0.0
        self.unprov = 0.0          # decayed count of unprovoked defections
        self.forgiven = 0.0        # decayed count of echo forgivenesses
        self.olive = 0             # forced-C rounds remaining
        self.model_mode = False
        self.last_test = 0
        self.test_gap = 25
        self.last_cc = 0           # last round of mutual cooperation
        self.peace_gap = 6
        self.next_peace = 6
        # opponent model: (my[t-2], op[t-2], my[t-1], op[t-1]) -> [n, c]
        self.model = {}

    # -- bookkeeping -------------------------------------------------------
    def observe(self):
        t = len(self.op)           # rounds completed
        if t >= 2:
            resp, prev = self.op[-1], self.my[-2]
            if prev == 'C':
                self.pn = self.pn * 0.95 + 1
                self.pc = self.pc * 0.95 + (resp == 'C')
            else:
                self.qn = self.qn * 0.95 + 1
                self.qc = self.qc * 0.95 + (resp == 'C')
        if t >= 3:
            key = (self.my[-3], self.op[-3], self.my[-2], self.op[-2])
            e = self.model.setdefault(key, [0.0, 0.0])
            e[0] = e[0] * 0.8 + 1
            e[1] = e[1] * 0.8 + (self.op[-1] == 'C')
        self.unprov *= 0.98
        self.forgiven *= 0.99
        if self.op[-1] == 'D' and all(m == 'C' for m in self.my[-3:-1]):
            self.unprov += 1
        if self.my[-1] == 'C' and self.op[-1] == 'C':
            self.last_cc = t
            self.peace_gap = 6
            self.next_peace = t + 6

    def p(self):
        return self.pc / self.pn

    def q(self):
        return self.qc / self.qn if self.qn > 0 else 0.0

    # -- best reply to the learned model -------------------------------------
    def pc_state(self, s):
        e = self.model.get(s)
        if not e:
            return PRIOR_C
        return (e[1] + 0.3 * PRIOR_C) / (e[0] + 0.3)

    def plan(self):
        states = [(a, b, c, d) for a in 'CD' for b in 'CD' for c in 'CD' for d in 'CD']
        pc = {s: self.pc_state(s) for s in states}
        V = {s: 0.0 for s in states}

        def qval(s, a):
            x = pc[s]
            return (x * (PAY[a, 'C'] + GAMMA * V[(s[2], s[3], a, 'C')])
                    + (1 - x) * (PAY[a, 'D'] + GAMMA * V[(s[2], s[3], a, 'D')]))

        for _ in range(120):
            V = {s: max(qval(s, 'C'), qval(s, 'D')) for s in states}
        s = (self.my[-2], self.op[-2], self.my[-1], self.op[-1])
        return 'C' if qval(s, 'C') > qval(s, 'D') + 1e-9 else 'D'

    # -- main decision -------------------------------------------------------
    def move(self):
        t = len(self.my)
        if t == 0:
            return 'C'
        self.observe()

        if self.olive > 0:
            self.olive -= 1
            return 'C'

        p, q = self.p(), self.q()
        if self.model_mode:
            if t >= 10 and all(a == 'C' and b == 'C' for a, b in
                               zip(self.my[-10:], self.op[-10:])):
                self.model_mode = False        # stable peace: back to TFT
            elif self.qn >= 2.5 and 1 + 4 * q < 3 * p and p > 0.8:
                # they punish defection and reward cooperation: make peace
                self.model_mode = False
                self.olive = 1
                return 'C'
            else:
                if 'C' in self.my[-self.test_gap:]:
                    self.last_test = max(self.last_test,
                                         t - 1 - self.my[::-1].index('C'))
                if t - self.last_test >= self.test_gap:
                    # all-D for a long while: test whether C is answered now
                    self.last_test = t
                    self.test_gap = min(self.test_gap * 2, 200)
                    return 'C'
                return self.plan()
        elif self.qn >= 2.5 and p < 0.7 and 1 + 4 * q > 3 * p + 0.5:
            # cooperation is not being reciprocated and defecting pays better
            self.model_mode = True
            self.last_test = t
            return self.plan()

        if self.op[-1] == 'C':
            return 'C'

        # opponent defected last round
        if t == 3 and self.my == ['C', 'C', 'D'] and self.op == ['C', 'D', 'D']:
            # opening two-round probe (seen in rounds 1 and 2): one D back is
            # accepted, a second one gets punished, so stop at one
            return 'C'
        if (t >= 2 and self.my[-2] == 'D' and self.op[-2] == 'C'
                and self.unprov < 2.5 and self.forgiven < 1.5):
            self.forgiven += 1
            # their D answers a D of mine made while they cooperated: this is
            # a retaliation echo, absorb it rather than bounce it back
            return 'C'
        if t >= self.next_peace and t - self.last_cc >= 6:
            # long stretch without mutual cooperation: offer peace
            self.peace_gap = min(self.peace_gap * 2, 100)
            self.next_peace = t + self.peace_gap
            self.olive = 1
            return 'C'
        return 'D'


def main():
    bot = Bot()
    out = sys.stdout
    inp = sys.stdin
    while True:
        try:
            m = bot.move()
        except Exception as e:      # never fail a match on a bug
            print(repr(e), file=sys.stderr)
            m = bot.op[-1] if bot.op else 'C'
        bot.my.append(m)
        out.write(m + '\n')
        out.flush()
        line = inp.readline()
        if not line:
            return
        bot.op.append('D' if line.strip() == 'D' else 'C')


if __name__ == '__main__':
    try:
        main()
    except BrokenPipeError:
        pass
