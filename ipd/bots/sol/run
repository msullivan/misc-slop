#!/usr/bin/env python3
"""A cooperative opening with retaliation and repair."""

import sys
from collections import deque


def play():
    move = "C"
    previous_move = None
    previous_opponent = None
    recent = deque(maxlen=12)
    cooperation_streak = 0
    mutual_cooperation_streak = 0
    mutual_defection_streak = 0
    established_cooperation = False
    recovery_moves = 0
    recovery_used = False
    repair_cooldown = 0
    defensive = False

    while True:
        print(move, flush=True)
        line = sys.stdin.readline()
        if not line:
            return
        opponent = line.strip()

        recent.append(opponent)
        cooperation_streak = cooperation_streak + 1 if opponent == "C" else 0
        if move == opponent == "C":
            mutual_cooperation_streak += 1
            if mutual_cooperation_streak >= 12:
                established_cooperation = True
        else:
            mutual_cooperation_streak = 0
        mutual_defection_streak = (
            mutual_defection_streak + 1 if move == opponent == "D" else 0
        )
        repair_cooldown = max(0, repair_cooldown - 1)

        if recent.count("D") >= 5:
            defensive = True
        if cooperation_streak >= 5:
            defensive = False

        if recovery_moves == 1 and opponent == "C":
            # The opponent accepted the recovery offer. Discard the old window.
            recent.clear()
            recent.append("C")
            defensive = False
        recovery_moves = max(0, recovery_moves - 1)

        if (
            defensive and established_cooperation and not recovery_used
            and mutual_defection_streak >= 8
        ):
            recovery_used = True
            recovery_moves = 2

        if recovery_moves:
            next_move = "C"
        elif defensive:
            next_move = "D"
        elif opponent == "C":
            next_move = "C"
        elif repair_cooldown == 0 and previous_opponent == "C" and (
            move == "D" or previous_move == "D"
        ):
            # Break mutual retaliation or a one-round echo of our defection.
            next_move = "C"
            repair_cooldown = 8
        else:
            next_move = "D"

        previous_move, previous_opponent = move, opponent
        move = next_move


if __name__ == "__main__":
    play()
