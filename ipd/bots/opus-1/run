#!/usr/bin/env python3
import os
import sys

sys.dont_write_bytecode = True

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from strategy import Opus  # noqa: E402


def main():
    bot = Opus()
    out = sys.stdout
    last = "C"
    broken = False
    while True:
        move = last
        if not broken:
            try:
                move = bot.move()
            except Exception as e:  # never forfeit a match over a bug
                print(f"strategy error: {e!r}; falling back to TFT",
                      file=sys.stderr)
                broken = True
                move = last
        out.write(move + "\n")
        out.flush()
        line = sys.stdin.readline()
        if not line:
            return
        last = "C" if line.strip() == "C" else "D"
        if not broken:
            bot.observe(last)


if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):
        pass
